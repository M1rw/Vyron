<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.8" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vyron.Core\Vyron.Core.csproj" />
  </ItemGroup>

  <!-- Reference Windows System DLLs for advanced APIs -->
  <ItemGroup>
    <Reference Include="amsi">
      <HintPath>C:\Windows\System32\amsi.dll</HintPath>
    </Reference>
    <Reference Include="fwpuclnt">
      <HintPath>C:\Windows\System32\fwpuclnt.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
