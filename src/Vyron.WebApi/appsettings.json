{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "VyronDatabase": "Server=(localdb)\\mssqllocaldb;Database=VyronEDR;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "VYRON-2026-SECRET-KEY-CHANGE-IN-PRODUCTION-MINIMUM-32-CHARACTERS",
    "Issuer": "vyron-api",
    "Audience": "vyron-client",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "VyronSettings": {
    "DetectionRate": 96.1,
    "Version": "2.0.0",
    "EnableHardwareSecurity": true,
    "EnableNeuralNetworks": true,
    "EnableUEBA": true,
    "EnableZeroTrust": true
  }
}
